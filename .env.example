# Environment Variables Configuration

# 1. Supabase & Database (Optional for local memory-store fallback mode, required for cloud production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 2. Safqa API Integration
# Sandbox base: https://api.safqapay.com/sandbox | Production: https://api.safqapay.com/v1
SAFQA_API_BASE_URL=https://api.safqapay.com/v1
SAFQA_MERCHANT_ID=your-safqa-merchant-id
SAFQA_API_SECRET_TOKEN=your-safqa-secret-token
SAFQA_WEBHOOK_SECRET=your-webhook-secret
SAFQA_SANDBOX_MODE=true

# 3. Meta Pixel & Conversions API (CAPI)
NEXT_PUBLIC_META_PIXEL_ID=your-meta-pixel-id
META_CAPI_ACCESS_TOKEN=your-meta-capi-access-token
META_TEST_EVENT_CODE=

# 4. App & Deployment URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 5. Admin security (REQUIRED — admin login is disabled without them)
ADMIN_PIN=use-a-long-random-pin
AUTH_SECRET=at-least-32-random-characters

# 6. Cloudflare KV REST fallback (or bind a KV namespace as STORE_KV)
CF_ACCOUNT_ID=
CF_KV_NAMESPACE_ID=
CF_API_TOKEN=scoped-token-with-workers-kv-edit-only
# legacy alternative to CF_API_TOKEN:
# CF_API_KEY=
# CF_EMAIL=

# 7. Safka dropshipping + webhooks (append ?secret=<SAFQA_WEBHOOK_SECRET> to webhook URLs in Safka)
SAFKA_API_KEY=

# 8. Telegram sales alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 9. Support chat LLM
LOCAL_LLM_KEY=
GEMINI_API_KEY=

# 10. Orders storage backend (see docs/architecture-kv-d1.md)
# kv (default) = orders in Cloudflare KV. d1 = orders, guards and visit counters in Cloudflare D1 (binding DB).
ORDERS_BACKEND=kv
# Verification period only: with ORDERS_BACKEND=d1, also copy each order to KV (1 KV write per order write)
# so switching back to kv loses nothing.
ORDERS_KV_MIRROR=
# Local development only: URL of scripts/dev-d1-server.mjs (next dev cannot see the DB binding)
# D1_REST_BASE_URL=http://127.0.0.1:3198

# 11. Catalog storage backend: products, offers, landing pages, settings (see docs/architecture-kv-d1.md)
# kv (default) = Cloudflare KV, as before. d1 = Cloudflare D1 (binding DB, migration 0004). Images stay in KV.
CATALOG_BACKEND=kv
# Verification period only: with CATALOG_BACKEND=d1, also copy every catalog/settings write to KV
# (the old KV writes again) so switching back to kv loses nothing.
CATALOG_KV_MIRROR=
# Seconds a D1 catalog read is cached per isolate (default 30, 0 disables). A save made through another
# isolate becomes visible to visitors after at most this long.
CATALOG_CACHE_TTL_SECONDS=30
