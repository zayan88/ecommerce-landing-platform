# Environment Variables Configuration

# 1. Supabase & Database (Optional for local memory-store fallback mode, required for cloud production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 2. Safqa API Integration
# Sandbox base: https://api.safqapay.com/sandbox | Production: https://api.safqapay.com/v1
SAFQA_API_BASE_URL=https://api.safqapay.com/v1
SAFQA_MERCHANT_ID=your-safqa-merchant-id
SAFQA_API_SECRET_TOKEN=your-safqa-secret-token
SAFQA_WEBHOOK_SECRET=your-webhook-secret
SAFQA_SANDBOX_MODE=true

# 3. Meta Pixel & Conversions API (CAPI)
NEXT_PUBLIC_META_PIXEL_ID=your-meta-pixel-id
META_CAPI_ACCESS_TOKEN=your-meta-capi-access-token
META_TEST_EVENT_CODE=

# 4. App & Deployment URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
